-- Make Draggable Function (Unchanged)
local function MakeDraggable(Frame)
    local dragging = false
    local dragStart, startPos
    local UIS = game:GetService("UserInputService")

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
        end
    end)

    Frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                         startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Notification Function - **Enlarged Size and Applied Shadow/Rounded Corners**
local function Notify(title, text)
    local NotifFrame = Create("Frame", {
        Size = UDim2.new(0, 280, 0, 60), -- **Enlarged Size (250x50 -> 280x60)**
        Position = UDim2.new(1, -290, 1, -70), -- Adjusted position
        BackgroundColor3 = Color.Secondary,
        BorderSizePixel = 0,
        Parent = GuiLibrary.ScreenGui
    })
    Create("UICorner", { CornerRadius = UDim.new(0, CornerRadius), Parent = NotifFrame })
    AddShadow(NotifFrame, Color3.new(0, 0, 0), 0.7, 2) -- Soft Shadow

    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0.4, 0),
        Text = title,
        TextColor3 = Color.Highlight,
        TextScaled = true,
        Font = Enum.Font.SourceSansBold,
        BackgroundTransparency = 1,
        Parent = NotifFrame
    })

    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0.4, 0),
        Position = UDim2.new(0, 0, 0.5, 0), -- Adjusted position
        Text = text,
        TextColor3 = Color.Text,
        TextScaled = true,
        Font = Enum.Font.SourceSans,
        BackgroundTransparency = 1,
        Parent = NotifFrame
    })

    NotifFrame:TweenPosition(UDim2.new(1, -290, 1, -70), "Out", "Quad", 0.5, true)
    wait(3)
    NotifFrame:TweenPosition(UDim2.new(1, -290, 1, 60), "In", "Quad", 0.5, true, function()
        NotifFrame:Destroy()
    end)
end

