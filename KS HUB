    D.Font = Enum.Font.Gotham
    D.TextSize = 10
    D.BackgroundTransparency = 1
    D.TextXAlignment = Enum.TextXAlignment.Left
    D.Parent = BtnFrame

    BtnFrame.MouseButton1Click:Connect(function()
        pcall(callback)
        Notify("Task Executed", name .. " Loaded.")
    end)
end

