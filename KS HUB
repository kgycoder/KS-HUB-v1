    T.TextXAlignment = Enum.TextXAlignment.Left
    T.Parent = BtnFrame
    
    local D = Instance.new("TextLabel")
    D.Size = UDim2.new(1, -30, 0, 15)
    D.Position = UDim2.new(0, 15, 0, 30)
    D.Text = desc
