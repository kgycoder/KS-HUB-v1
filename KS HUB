-- **UI Functions for Natural Shadow/Glow Effect**
local function AddShadow(Target, Color, Transparency, Thickness)
    -- Using UIStroke for a pseudo-shadow/glow effect
    local UIStroke = Create("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, -- Apply to outer border (for glow/shadow look)
        Color = Color,
        Transparency = Transparency,
        Thickness = Thickness,
        LineJoinMode = Enum.LineJoinMode.Round,
        Parent = Target
    })
end

