local function CreateTab(Name, LayoutOrder)
    local TabButton = Create("TextButton", {
        Size = UDim2.new(0.9, 0, 0, 35), -- Increased Height
        Text = Name,
        TextColor3 = Color.Text,
        Font = Enum.Font.SourceSansBold,
        TextSize = 16, -- Increased Font Size
        BackgroundColor3 = Color.Accent,
        BackgroundTransparency = 0, -- Removed Transparency
        BorderSizePixel = 0,
        LayoutOrder = LayoutOrder,
        AutoButtonColor = false, -- **[추가: 오류 수정]**
        Parent = TabContainer
    })
    Create("UICorner", { CornerRadius = UDim.new(0, CornerRadius), Parent = TabButton })
    
    -- Default Button Shadow/Glow
    AddShadow(TabButton, Color3.new(0, 0, 0), 0.7, 1) 

    local TabContent = Create("Frame", {
        Size = UDim2.new(1, -110, 1, 0), -- Adjusted for TabBar Width
        Position = UDim2.new(0, 110, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = ContentFrame
    })

    local ContentLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 8), -- Increased Spacing
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabContent
    })
    Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 10), Parent = TabContent }) -- Added Content Padding

    TabContents[Name] = { Button = TabButton, Content = TabContent }

    TabButton.MouseButton1Click:Connect(function()
        for _, tab in pairs(TabContents) do
            tab.Content.Visible = false
            tab.Button.BackgroundColor3 = Color.Accent
        end
        TabContent.Visible = true
        TabButton.BackgroundColor3 = Color.TabActive -- Active Tab Background Color
        CurrentTab = Name
    end)

    return TabContent
end

local function CreateButton(TabContent, Text, ScriptCode, LayoutOrder)
    local Button = Create("TextButton", {
        Size = UDim2.new(1, -20, 0, 35), -- Adjusted Width/Height
        Text = Text,
        TextColor3 = Color.Highlight,
        Font = Enum.Font.SourceSansBold,
        TextSize = 16,
        BackgroundColor3 = Color.Accent,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        LayoutOrder = LayoutOrder,
        AutoButtonColor = false, -- **[추가: 오류 수정]**
        Parent = TabContent
    })
    Create("UICorner", { CornerRadius = UDim.new(0, CornerRadius), Parent = Button })
    
    -- Script Button Shadow/Glow
    AddShadow(Button, Color3.new(0, 0, 0), 0.6, 1) 

    Button.MouseButton1Click:Connect(function()
        pcall(function()
            loadstring(ScriptCode)()
        end)
        Notify("✅ Script Executed", Text .. " script executed successfully.")
    end)
    
    -- Mouse Over Effect Added (Advanced Presentation)
    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfoStandard, { BackgroundColor3 = Color3.fromRGB(80, 80, 85) }):Play() 
        TweenService:Create(Button, TweenInfoStandard, { TextColor3 = Color.Highlight }):Play() 
    end)
    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfoStandard, { BackgroundColor3 = Color.Accent }):Play() 
        TweenService:Create(Button, TweenInfoStandard, { TextColor3 = Color.Highlight }):Play() 
    end)
end

